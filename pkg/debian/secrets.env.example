# Memo secrets — pushed by your deployment/secrets management system.
#
# This file is NOT shipped by the memo-rag package. Create it at:
#   /etc/memo/secrets.env
#
# The systemd unit loads it via EnvironmentFile=-/etc/memo/secrets.env
# (the leading dash makes it optional, so memo-arcana starts without it).
#
# Permissions: 640 root:memo
#
# These env vars are available for ${VAR} substitution inside
# /etc/memo/namespaces.yaml. Example:
#
#   namespaces:
#     - ns: myapp
#       db: postgres://myapp:${DB_PASSWORD}@localhost/myapp
#       service: openai
#       api_key: ${OPENAI_API_KEY}

# Embedding provider API key
OPENAI_API_KEY=sk-...

# Database password (optional — only if your namespaces.yaml uses ${DB_PASSWORD})
#DB_PASSWORD=...
