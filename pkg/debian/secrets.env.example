# Memo secrets — pushed by your deployment/secrets management system.
#
# This file is NOT shipped by the memo package. Create it at:
#   /etc/memo/secrets.env
#
# The systemd unit loads it via EnvironmentFile=-/etc/memo/secrets.env
# (the leading dash makes it optional, so memo-arcana starts without it).
#
# Permissions: 640 root:memo
#
# These env vars are then available for ${VAR} substitution inside
# /etc/memo/namespaces.yaml at load time. Example namespaces.yaml:
#
#   namespaces:
#     - ns: wow
#       db: postgres://wow:${WOW_DB_PASSWORD}@localhost/wow_dev
#       service: openai
#       api_key: ${OPENAI_API_KEY}
#       preload: true

# --- Embedding provider API keys ---

# OpenAI (for text-embedding-3-small, text-embedding-3-large, etc.)
OPENAI_API_KEY=sk-...

# Voyage AI (for voyage-3, voyage-code-3, etc.)
#VOYAGE_API_KEY=pa-...

# --- Database passwords (referenced by namespaces.yaml) ---

# Per-namespace Postgres passwords. Name them however your namespaces.yaml
# references them. Example for a "wow" namespace:
#
#WOW_DB_PASSWORD=...
