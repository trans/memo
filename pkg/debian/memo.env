# Memo configuration
# Restart memo-arcana.service after editing: sudo systemctl restart memo-arcana

# Database (required)
# SQLite: MEMO_DB=/var/lib/memo/memo.db
# Postgres: MEMO_DB=postgres://user:pass@localhost/memo
MEMO_DB=

# Arcana bus connection
ARCANA_HOST=127.0.0.1
ARCANA_PORT=10506

# Embedding service (default: mock)
# Options: mock, openai, voyage
MEMO_SERVICE=mock

# API key for the embedding provider (required for openai/voyage)
#OPENAI_API_KEY=

# USearch index directory
MEMO_INDEX_DIR=/var/lib/memo/indices
