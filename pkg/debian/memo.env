# Memo Arcana service configuration
# Restart memo-arcana.service after editing: sudo systemctl restart memo-arcana

# Arcana bus connection
ARCANA_HOST=127.0.0.1
ARCANA_PORT=19118

# Namespace config file (defines per-project DBs and embedding services)
MEMO_NAMESPACES=/etc/memo/namespaces.yaml

# Fallback API key for embedding providers. Can be overridden
# per-namespace in namespaces.yaml. Uncomment and set as needed:
#OPENAI_API_KEY=
#VOYAGE_API_KEY=
